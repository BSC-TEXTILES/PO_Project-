    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.6"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^10.0.5",
    "jsdom": "^26.1.0",
    "vite": "^6.4.6",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "esbuild": "^0.25.0"
  }
}
