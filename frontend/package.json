{
  "name": "poms-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:full": "concurrently -k -n api,web -c blue,green \"cd ../backend && node src/server.js\" \"vite\"",
